{
  "compilerOptions": {
    "baseUrl": ".",

    "paths": {
      "src/*": ["src/*"],
      "src/components/*": ["src/components/*"]
    },
    "resolveJsonModule": true,
    "target": "es6",
    "module": "CommonJS",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true
  }
}
